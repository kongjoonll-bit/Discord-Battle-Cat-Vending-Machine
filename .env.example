# .env 예시 파일 - 복사해서 .env 로 사용하세요 (cp .env.example .env)
# .env 는 .gitignore 에 등록되어 커밋되지 않습니다.

# Discord 봇 토큰 (비워두면 대시보드에 저장된 토큰 사용)
DISCORD_TOKEN=your_bot_token_here

# 세션/CSRF 서명 키 (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change_me_to_random_string

# 웹 서버 포트 (기본 5000)
PORT=5000
